# jipsa 환경 변수. 복사해 .env로 두고 값을 채운다. .env는 git에 넣지 않는다.

# Slack 전용 채널의 Incoming Webhook 주소. 비어 있으면 보고를 보내지 않고 reports/에만 남긴다.
JIPSA_SLACK_WEBHOOK=

# 작업자 모델(claude -p). 별칭 또는 모델 ID.
JIPSA_MODEL_WORKER=opus
# 가벼운 호출(진전 판정, 저장 커밋 메시지) 모델. 판정 기록에 남으므로 모델 ID로 적는다.
JIPSA_MODEL_FAST=claude-haiku-5-5
# 분석자 모델(codex exec).
JIPSA_CODEX_MODEL=gpt-6.1-sol

# Ollama 서버. 리스 반납 때 /api/ps로 적재 모델을 확인한다.
JIPSA_OLLAMA_URL=http://127.0.0.1:11434

# Auto 모드 종료 시각(가정).
JIPSA_CUTOFF=06:30
# 동시에 돌리는 작업 수.
JIPSA_CONCURRENCY=3

# 서칭 단계가 웹보다 먼저 볼 로컬 자료 폴더. `이름=경로;이름=경로` 꼴이다. 비우면 웹만 본다.
# 예: JIPSA_SEARCH_SOURCES=기사 모음=~/notes/articles;아이디어 카드=~/notes/ideas
JIPSA_SEARCH_SOURCES=

# 시험용 폴더. 비우면 jipsa 폴더 아래 runtime/state, runs, reports, projects를 쓴다.
# JIPSA_STATE_DIR=
# JIPSA_RUNS_DIR=
# JIPSA_REPORTS_DIR=
# JIPSA_PROJECTS_DIR=
